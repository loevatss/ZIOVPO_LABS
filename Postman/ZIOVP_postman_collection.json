        {
          "name": "Каталог продуктов и типов лицензий",
          "item": [
            {
              "name": "Получение каталога продуктов",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminAccessToken}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/licenses/catalog/products",
                  "host": ["{{baseUrl}}/api/licenses/catalog/products"],
                  "path": []
                }
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "if (Array.isArray(json) && json.length > 0) { pm.collectionVariables.set('productId', json[0].id); }"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Получение каталога типов лицензий",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminAccessToken}}",
                    "type": "text"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/licenses/catalog/types",
                  "host": ["{{baseUrl}}/api/licenses/catalog/types"],
                  "path": []
                }
              },
              "response": [],
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "if (Array.isArray(json)) {",
                      "  const trial = json.find(x => x.name === 'TRIAL');",
                      "  if (trial) pm.collectionVariables.set('typeTrialId', trial.id);",
                      "}"
                    ]
                  }
                }
              ]
            }
          ]
        },
